extends "res://tests/deer_rest_quest_tests.gd"

func run() -> void:
	create_timer(45).timeout.connect(func(): quit(2))
	directory = "res://artifacts/marker-arrival-20261112/run-%d/"%Time.get_ticks_usec()
	DirAccess.make_dir_recursive_absolute(directory)
	Slots.auto_path = directory+"auto.json"
	Session.index_path = directory+"session.json"
	Session.clear_selection()
	path = Slots.working_path()
	root.get_node("SavePlaytime").set_process(false)
	root.get_node("GameSettings").apply_values({"background_pause":false,"dialogue_speed":"instant","dialogue_auto":false})
	root.get_node("GameSettings").set_application_focus(true)
	AudioServer.set_bus_mute(0,true)
	await switch_to("diecuifeng",9)
	check(not map.event_state.is_active(),"unmarked tree does not start before deer")
	var ordinary: Dictionary = map.event_registry.events["base.map_event.diecuifeng.encounter_n11"]
	arrive(11)
	check(not map.event_state.is_active() and not map._try_start_event(ordinary.point_id,"click",true),"N11 encounter locked for arrival and click before task")
	check(not map.content.get_node("Points/N11/Sign").visible,"locked original encounter sign hidden")
	arrive(18)
	check(Deer.story(state).active=="deer" and map.travel.paused,"yellow deer marker auto starts on arrival")
	check(map.dialogue.picture.requested_visible and map.dialogue.speaker_name.text=="旁白","arrival uses existing illustration and narrator")
	map._advance_dialogue()
	await switch_to("diecuifeng",18)
	check(Deer.story(state).active=="deer" and Deer.story(state).line==1,"reload resumes cursor without restarting")
	finish_deer()
	await settle()
	check(Deer.story(state).active.is_empty() and not map.event_state.is_active(),"finished opening releases control without looping")
	check(map.deer_rest_controller.signs.entries[Deer.data.tree.point_id].overlay.visible and Deer.data.tree.point_id.ends_with("n09"),"yellow marker moves to screenshot N09")
	arrive(11)
	check(not map.event_state.is_active(),"N11 remains locked after deer conversation")
	arrive(10)
	check(map.travel.request_destination(Deer.data.tree.point_id),"real route to tree is walkable")
	map.travel.advance(100)
	check(map.travel.current_node_id==Deer.data.tree.point_id and Deer.story(state).active=="inspect" and map.travel.paused,"walking onto yellow tree marker starts investigation")
	finish_deer()
	check(Deer.story(state).choice_pending and map.deer_rest_controller.choices.visible,"arrival leads to two choices")
	check(map.encounter_dialog==null or not map.encounter_dialog.visible,"arrival never opens ordinary encounter popup")
	map.deer_rest_controller.choose("leave")
	finish_deer()
	await settle()
	check(not map.event_state.is_active() and not map.travel.paused,"leave stays free on the marked node")
	arrive(10)
	check(map.travel.request_destination(Deer.data.tree.point_id),"return route available")
	map.travel.advance(100)
	check(Deer.story(state).active=="decision" and Deer.story(state).choice_pending,"revisit marked tree automatically reopens choice")
	var old := state.snapshot()
	old.quests[Deer.ID].location = Deer.data.legacy_tree.duplicate()
	old.map_location = Deer.data.legacy_tree.duplicate()
	var migrated: MapLoadoutState = MapLoadoutStore.candidate(state).state
	check(migrated.restore(old).is_empty() and Deer.story(migrated).location==Deer.data.tree and Deer.story(migrated).choice_pending,"old N11 choice migrates to new trigger without losing progress")
	check(migrated.map_location==Deer.data.legacy_tree,"migration does not teleport player")
	map.deer_rest_controller.choose("leave")
	finish_deer()
	check(click_tree() and Deer.story(state).choice_pending,"stationary click remains usable")
	map.deer_rest_controller.choose("leave")
	finish_deer()
	var completed := state.snapshot()
	completed.quests[Deer.ID].stage = "completed"
	completed.quests[Deer.ID].battle_started = true
	completed.quests[Deer.ID].completed_day = WorldCalendar.current_day(state.calendar)
	completed.narrative.flags[Deer.LEGACY_REST_FLAG] = true
	completed.quests[Deer.ID].erase("reward_pending")
	check(state.restore(completed).is_empty(),"completed legacy fixture valid without new field")
	check(not state.narrative.flags.has(Deer.LEGACY_REST_FLAG) and not Deer.story(state).reward_pending,"old rest entitlement retired without replaying completion")
	check(MapEventRegistry.is_unlocked(state,ordinary),"completed old progress also unlocks original encounter")
	arrive(11)
	check(map.event_state.phase=="encounter" and map.event_state.active_id==ordinary.id,"restored N11 original encounter opens on arrival")
	check(map.event_state.active_event().enemy_id=="base.enemy.biyetengling" and map.event_state.active_event().respawn_days==20,"original enemy and respawn rule retained")
	map._retreat_encounter()
	arrive(10)
	arrive(9)
	check(not map.event_state.is_active() and Deer.story(state).active.is_empty(),"removed marker does not autoplay completed story")
	state.advance_days(1,"base.test.marker_wait")
	arrive(10)
	arrive(9)
	check(Deer.story(state).active.is_empty(),"unmarked optional coda still waits for deliberate click")
	check(click_tree() and Deer.story(state).active=="epilogue","unmarked coda click preserved")
	finish_deer()
	var result := {"checks":checks,"failures":failures,"directory":directory}
	FileAccess.open(directory+"validation.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"))
	print("DEER_ARRIVAL "+JSON.stringify(result))
	map.deactivate_location()
	map.free()
	quit(1 if failures else 0)
