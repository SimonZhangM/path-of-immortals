extends "res://tests/t01_integration_tests.gd"

func run() -> void:
	check(registry.load_base_content(), "base content loads")
	var created := MapLoadoutStore.create_state(registry, registry.get_board("base.board.bag"))
	check(created.error.is_empty(), "item catalog loads")
	loadout = created.state
	var item := registry.get_item("base.map_item.t01_0088")
	check(item.cooldown_usec == 4_000_000, "registered bell cooldown is four simulation seconds")
	check(loadout.records[item.id].cooldown == 4, "inventory detail uses four seconds")
	var sim := make_battle(item.id)
	sim.settlement_interval_usec = GameManager.BATTLE_SETTLEMENT_USEC
	check(sim.start(), "battle starts")
	sim.advance(3.5)
	check(sim.state.item_runtime["test.item"].activation_count == 0, "bell does not fire before four seconds")
	sim.advance(0.5)
	check(sim.state.item_runtime["test.item"].activation_count == 1, "bell fires at four seconds")
	check(T01CombatRules.layers(sim.state.teams[0][0],"生机") == 3, "bell still grants three regeneration layers")
	sim.advance(4)
	check(sim.state.item_runtime["test.item"].activation_count == 2, "bell repeats at eight seconds")
	var grid := BattleStatusIcons.new()
	root.add_child(grid)
	grid.configure()
	check(not grid.show_all_for_testing, "status component defaults to actual statuses")
	var owner: PartyMemberState = sim.state.teams[0][0]
	var enemy: PartyMemberState = sim.state.teams[1][0]
	owner.combat_statuses.clear()
	grid.refresh(owner)
	check(not grid.visible, "no status hides entire group")
	sim.t01.apply_status(owner,"生机",2,owner,sim.state.time_usec)
	sim.t01.apply_status(owner,"流血",1,enemy,sim.state.time_usec)
	grid.refresh(owner)
	check(grid.slots.values().filter(func(slot: Control): return slot.visible).size() == 2, "only active buff and debuff shown")
	check(grid.slots["生机"].visible and grid.counts["生机"].text == "2" and grid.slots["流血"].visible, "active icons and layers match authoritative state")
	sim.t01.consume(owner,"生机",2)
	grid.refresh(owner)
	check(not grid.slots["生机"].visible and grid.slots["流血"].visible, "expired buff disappears while debuff remains")
	grid.refresh(enemy)
	check(not grid.visible, "enemy without statuses also hides group")
	sim.t01.apply_status(enemy,"流血",1,owner,sim.state.time_usec)
	grid.refresh(enemy)
	check(grid.slots["流血"].visible and grid.slots.values().filter(func(slot: Control): return slot.visible).size() == 1, "enemy shows only its own active status")
	grid.free()
	var ui = load("res://scripts/ui/main_ui.gd").new()
	check(not ui.preview_all_status_icons, "formal battle UI defaults to actual statuses")
	ui.free()
	var team := TeamPanel.new()
	check(not team.preview_all_status_icons, "both team panels default to actual statuses")
	team.free()
	print("QINGMULING / STATUS DEFAULTS: %d checks, %d failures" % [checks,failures.size()])
	quit(1 if not failures.is_empty() else 0)
