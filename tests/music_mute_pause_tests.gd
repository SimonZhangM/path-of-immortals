extends "res://tests/save_actions_tests.gd"

const EntryMusic = preload("res://scripts/entry/entry_music.gd")
var settings: Node
var presentation: Node
var master_bus: int
var music_bus: int

func freezes(player: AudioStreamPlayer, label: String) -> void:
	await create_timer(0.08).timeout
	var position := player.get_playback_position()
	await create_timer(0.15).timeout
	check(player.stream_paused and absf(player.get_playback_position() - position) < 0.025, label)

func advances(player: AudioStreamPlayer, label: String) -> void:
	await create_timer(0.05).timeout
	var position := player.get_playback_position()
	await create_timer(0.15).timeout
	check(not player.stream_paused and player.get_playback_position() > position + 0.05, label)

func bus_toggle(player: AudioStreamPlayer, label: String) -> void:
	player.seek(5.0)
	AudioServer.set_bus_mute(master_bus, true)
	await freezes(player, label + " freezes when master is muted")
	var position := player.get_playback_position()
	AudioServer.set_bus_mute(master_bus, false)
	await advances(player, label + " resumes when master is unmuted")
	check(player.get_playback_position() >= position, label + " resumes from retained position")

func run() -> void:
	create_timer(35).timeout.connect(func(): quit(2))
	settings = root.get_node("GameSettings")
	presentation = root.get_node("MapPresentation")
	settings.apply_values({"background_pause":false,"background_mute":true,"volume_master":1.0,"volume_music":1.0})
	settings.set_application_focus(true)
	master_bus = AudioServer.get_bus_index("Master")
	music_bus = AudioServer.get_bus_index("Music")
	# Keep the test inaudible without setting either tested bus to zero.
	settings._base_gain.volume_master = 0.000001
	settings.apply_values({"volume_master":1.0})
	AudioServer.set_bus_mute(master_bus, false)
	var menu: AudioStreamPlayer = EntryMusic.ensure_for(self)
	await settle()
	check(menu is MusicPlayer, "menu uses shared music player")
	await bus_toggle(menu, "menu music")
	AudioServer.set_bus_mute(music_bus, true)
	await freezes(menu, "Music bus mute freezes menu")
	AudioServer.set_bus_mute(music_bus, false)
	await advances(menu, "Music bus unmute resumes menu")
	settings.preview_audio({"volume_music":0.0})
	await freezes(menu, "zero music preview freezes menu")
	settings.cancel_preview()
	await advances(menu, "canceling zero preview resumes menu")
	settings.apply_values({"volume_master":0.0})
	await freezes(menu, "zero applied master volume freezes menu")
	settings.apply_values({"volume_master":1.0})
	await advances(menu, "restoring master volume resumes menu")
	settings.apply_values({"background_pause":true})
	settings.set_application_focus(false)
	check(paused and AudioServer.is_bus_mute(master_bus), "background focus policy applied")
	await freezes(menu, "background mute freezes music while tree is paused")
	settings.set_application_focus(true)
	await advances(menu, "foreground resumes retained menu music")
	settings.apply_values({"background_pause":false})
	settings.set_application_focus(false)
	settings.preview_audio({"volume_music":0.0})
	settings.set_application_focus(true)
	await freezes(menu, "clearing background mute preserves zero-volume pause")
	settings.cancel_preview()
	await advances(menu, "clearing final mute reason resumes music")
	AudioServer.set_bus_mute(music_bus, true)
	menu._next_track()
	await freezes(menu, "playlist switch while muted starts paused")
	AudioServer.set_bus_mute(music_bus, false)
	await advances(menu, "new menu track resumes after unmute")
	var definition := {"id":"test.mute.map","music":["res://assets/bgm-baishacun.mp3"]}
	presentation.enter_map(definition, 0.0)
	await settle()
	check(presentation.music is MusicPlayer, "map uses shared music player")
	await bus_toggle(presentation.music, "map music")
	AudioServer.set_bus_mute(master_bus, true)
	var overlay: Dictionary = presentation.suspend_for_overlay()
	check(not overlay.paused, "overlay saves requested pause independently of mute")
	AudioServer.set_bus_mute(master_bus, false)
	await freezes(presentation.music, "unmuting preserves map overlay pause")
	presentation.resume_from_overlay(overlay)
	await advances(presentation.music, "closing overlay resumes map")
	presentation.music.set_context_paused(true)
	AudioServer.set_bus_mute(master_bus, true)
	AudioServer.set_bus_mute(master_bus, false)
	await freezes(presentation.music, "existing context pause survives mute cycle")
	presentation.music.set_context_paused(false)
	var manager := GameManager.new()
	var battle := GameAudio.new()
	root.add_child(battle)
	battle.configure(manager, true)
	battle.start_music()
	check(battle.music is MusicPlayer, "battle uses shared music player")
	await bus_toggle(battle.music, "battle music")
	battle.play_victory()
	await bus_toggle(battle.music, "victory music")
	battle.queue_free()
	manager.free()
	await settle()
	var screen := Control.new()
	root.add_child(screen)
	var session: RefCounted = load("res://scripts/map/map_breakthrough_session.gd").new()
	session.phase = "running"
	session.started = true
	var audio_view: Node = load("res://scripts/map/map_breakthrough_audio.gd").new()
	screen.add_child(audio_view)
	audio_view.configure(session, screen, ContentRegistry.new())
	check(audio_view.music is MusicPlayer, "breakthrough uses shared music player")
	await bus_toggle(audio_view.music, "breakthrough music")
	session.set_paused(true)
	await advances(audio_view.music, "breakthrough gameplay pause still permits music")
	AudioServer.set_bus_mute(master_bus, true)
	await freezes(audio_view.music, "mute pauses BGM during paused breakthrough")
	screen.hide()
	AudioServer.set_bus_mute(master_bus, false)
	await freezes(audio_view.music, "unmute does not resume hidden breakthrough music")
	await advances(presentation.music, "map resumes after muted breakthrough closes")
	screen.show()
	await advances(audio_view.music, "reopening breakthrough resumes its retained BGM")
	AudioServer.set_bus_mute(master_bus, true)
	audio_view.music.stop()
	AudioServer.set_bus_mute(master_bus, false)
	await settle()
	check(not audio_view.music.playing, "unmute does not restart stopped music")
	screen.queue_free()
	await settle()
	presentation.music.stop()
	settings._base_gain.volume_master = 1.0
	print("Music mute pause: ",checks," checks, ",failures," failures")
	quit(1 if failures else 0)
