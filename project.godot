; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Path of Immortals"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=2560
window/size/window_height_override=1440
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

battle_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
speed_half={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
speed_normal={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}
speed_double={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
