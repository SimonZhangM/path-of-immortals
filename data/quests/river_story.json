    "clinic_arrival": {
      "lines": [
        "（担架在医馆内放稳。你和帮工将沈砚舟扶上床，清禾随即俯身，检查一路上有没有牵动伤口。）",
        "还好，包扎没松。先躺着，别急着起来。",
        "（替沈砚舟掖好被角，走到门边叫住一位帮工。）",
        "劳烦你去青岚宗山下驻点报个信。外门弟子沈砚舟在河湾受了伤，已经接到医馆，请他们派人来看看。",
        "（又托留守的人将河湾伤人的情况报给周镇长，顺便给药铺捎句话，告诉叶伯人已经接回来了。）",
        "有劳苏姑娘了。还有{player.familiar_name}，来回跑了几趟，我都记着。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.npc.suqinghe",
        "base.npc.suqinghe",
