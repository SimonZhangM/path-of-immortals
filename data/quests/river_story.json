    "beasts_gone": {
      "lines": [
        "（外面的刨地声已经停了。你隔着门柱望向坡下，最后几道兽影正隐进远处的树林。）",
        "总算走远了。现在回去。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
