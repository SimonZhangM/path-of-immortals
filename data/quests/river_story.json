    "entrance": {
      "lines": [
        "（走进旧祠，身后又传来一阵杂乱的兽蹄声。你回头望去，几道兽影已绕到坡下，正沿着来时的路往这边走。）",
        "怎么一下来了这么多……",
        "（你退到门内的石柱后。外面的动静停了停，又传来低吼和刨地的声音。）",
        "这里背阴，墙脚也湿，说不定有青藤。先在里面找找，等外面安静了再走。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n01",
      "requires": [
        "injured"
      ],
      "any_point": true
    },
    "blocked_exit": {
      "lines": [
        "（探头向石阶下看去，林边还有兽影。你收回脚步，仍留在门内。）",
        "还没走远，现在出去不妥。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n01",
      "requires": [
        "entrance"
      ],
      "repeat": true
    },
