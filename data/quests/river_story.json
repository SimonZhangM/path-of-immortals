    "invite_doctor": {
      "lines": [
        "（见你匆匆进门，放下手里的药包，转身迎过来。）",
        "怎么这么急？出什么事了？",
        "河湾有个青岚宗弟子受伤了，叫沈砚舟。我给他处理了外伤，可他站不起来。",
        "人还清醒吗？血止住没有？",
        "清醒，能说话。血暂时止住了，他说经脉也伤了，一动就疼。",
        "好，别让他硬撑着走。你先把他在哪儿、哪条路好走告诉我，我收拾药箱。",
        "小庙旁的石壁下面。我回来走的那条路能通。",
        "那你带路。我叫两个人一起，带上担架，免得到时搬不动他。",
        "（打开药箱，检查药包和净布，随后叫来两位帮工，请他们准备担架，并向留守的人交代医馆的事。）",
        "我能帮你拿什么？",
        "这包净布给你。拿稳些呀，别和你那一篓草叶挤在一起。",
        "分开放着，我记得。",
        "嗯，走吧。"
      ],
      "line_speakers": [
        "base.npc.suqinghe",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
        "base.npc.suqinghe"
      ],
      "map_id": "base.map.qingshizhen",
      "point_id": "base.map.qingshizhen.point.n32",
      "requires": [
        "medicine"
      ],
      "illustration": {
        "image": "res://assets/map-event-2-7.webp"
      }
    },
    "pickup": {
      "lines": [
        "（你领着清禾和两位帮工来到小庙旁。沈砚舟抬起头，清禾已经放下药箱，在他身边蹲下。）",
        "沈公子，我是青石镇医馆的苏清禾。先别起身，我看看。",
        "有劳苏姑娘。我这经脉……",
        "经脉的伤，我还治不了。先处理外伤，看看能不能搬动，回镇以后再联系你宗里。",
        "（仔细查看伤处和包扎，换好药，重新固定，才示意帮工将担架放到近处。）",
        "你先前处理得及时。现在搬动得慢些，别牵着伤口。",
        "我扶住这边？",
        "对，等我数到三，再一起抬。到了窄处就停一下，慢慢来。",
        "我原是来查山兽的，如今倒让镇上的人来抬我。",
        "先回去。山兽的事，等你能下床再说。",
        "就是。眼下先把自己顾好，别急着办差。",
        "（你和帮工依着清禾的指示扶稳沈砚舟，将他安置在担架上，随后沿来时的路往镇子走。）"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.npc.suqinghe",
        "base.npc.shenyanzhou",
        "base.npc.suqinghe",
        "base.npc.suqinghe",
        "base.npc.suqinghe",
        "base.map_player.chen_yu",
