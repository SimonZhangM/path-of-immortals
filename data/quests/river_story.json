    "blood_herb": {
      "lines": [
        "止血的药有了，再去找些青藤根。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.qingshihewan",
      "point_id": "base.map.qingshihewan.point.n04",
      "any_point": true,
      "requires": [
        "injured"
      ]
    },
    "medicine": {
      "lines": [
        "（回到小庙旁，沈砚舟仍靠在石边。听见脚步，他抬头看向你手里的药包。）",
        "回来了。路上还顺利？",
        "药找齐了。路上有群山兽，躲了一会儿才出来。",
        "你没伤着吧？",
        "没有。先看你的伤。",
        "（你按平时学过的办法处理止血草，替他重新包扎，又将备好的青藤根用于调养。过了一阵，伤口不再渗血，他的脸色也缓和了些。）",
        "血没有再往外渗了。你试着挪一点，疼就停。",
        "（扶着石壁试着起身，刚挪了半步便停下来，缓缓坐回原处。）",
        "腿使不上力，胸口也还闷。我得再调息。",
        "那就别硬走。我回镇找清禾姐，她在医馆。得让她看过，再想办法接你回去。",
        "又要劳你往返。",
        "镇子近些，我去请她来。你这样也不能一直留在山里。",
        "你先坐稳，别自己往外走。",
        "好，我就在这里等。",
        "（你把剩下的净布和水放在他伸手能拿到的地方，确认他坐稳，才起身收拾药篓。）"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.npc.shenyanzhou",
        "base.map_player.chen_yu",
        "base.npc.shenyanzhou",
        "base.map_player.chen_yu",
