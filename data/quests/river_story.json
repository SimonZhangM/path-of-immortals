    "fox_notice": {
      "lines": [
        "（蛛网下的碎木间，有一团小小的身影动了动。你停下脚步，听见一声细弱的呜咽。）",
        "里面有东西？",
        "（拨开遮住视线的枯叶，才看清是一只小狐狸。它的后腿缠在蛛丝里，见你靠近，立刻缩起身子。）",
        "别怕，我不是来抓你的。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n17",
      "requires": [],
      "optional": true,
      "next_scene": "fox_choice",
      "illustration": {
        "image": "res://assets/map-event-2-2a.webp"
      }
    },
    "fox_choice": {
      "lines": [
        "小狐狸蜷在蛛网下，后腿仍被细丝缠住。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n17",
      "requires": [
        "fox_notice"
      ],
      "optional": true,
      "repeat": true,
      "choices": [
        {
          "id": "rescue",
          "text": "靠近救它",
          "next_scene": "fox_rescue"
        },
        {
          "id": "leave",
          "text": "先离开这里",
          "next_scene": "fox_leave"
        }
      ],
      "illustration": {
        "image": "res://assets/map-event-2-2a.webp"
      }
    },
    "fox_rescue": {
      "lines": [
        "（来路上的灰蛛已不再挡路。你蹲在碎木旁，用枯枝挑开外围的蛛丝，小狐狸却又往后缩了缩。）",
        "再退，腿就缠得更紧了。让我看看，好不好？",
        "（小狐狸盯着你的手，耳朵压得很低。你停了一会儿，等它不再挣扎，才一点点拨开缠住后腿的细丝。）",
        "好了，松开了。慢些，先别急着跑。",
        "（它试着撑起身子，后腿刚落地便又伏了下去。腿上有些擦伤，呼吸仍然很急。）",
        "还走不稳啊……这里也不是歇脚的地方。",
        "（你把一块干净的布铺在药篓空着的一侧，轻轻托起它。它僵了一下，前爪紧紧抵着布边，却没有再挣扎。）",
        "先带你出去。外面找个安全些的地方，再放你走。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n17",
      "requires": [
        "fox_notice"
      ],
      "optional": true
    },
    "fox_leave": {
      "lines": [
        "这边的蛛网太密，得先看清周围。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n17",
      "requires": [
        "fox_notice"
      ],
      "optional": true,
      "repeat": true
    },
    "fox_release": {
      "lines": [
        "（你在远离兽迹的树丛边停下，把药篓放稳，将小狐狸轻轻抱到地上。）",
        "这里没蛛网了。试试看，能走吗？",
        "（小狐狸站了一会儿，试探着迈出几步。这回没有再趴下，却也没往林里跑。）",
        "走吧，别再往那祠里钻了。",
        "（它站在草边，抬头望着你。你理好篓里的布，背起药篓，它仍没有挪开目光。）",
        "怎么，还舍不得走？",
        "（小狐狸又看了你很久，才慢慢退进树影。它在低草后又停了片刻，最后转身隐入林中。）",
        "……小家伙。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.qingshihewan",
      "point_id": "base.map.qingshihewan.point.n02",
      "requires": [
        "fox_rescue"
      ],
      "optional": true,
      "illustration": {
        "image": "res://assets/map-event-2-2b.webp",
        "start_line": 1
      }
    },
    "array": {
      "lines": [
        "（石台上的刻痕一圈套着一圈，几道细槽连向四周的小石柱。槽里积了灰土，边角还长着青苔。）",
        "这些纹路倒刻得齐整……不像只是摆着好看的。",
        "（你绕着石台看了看，没有找到能读懂的字，也看不出它原来是做什么用的。）",
        "先记着这里。以后碰到懂行的人，再问问。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n26",
      "requires": [],
      "optional": true
    },
    "array_again": {
      "lines": [
        "还是看不明白。先别乱动。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n26",
      "requires": [
        "array"
      ],
      "optional": true,
      "repeat": true,
      "manual": true
    },
    "wood_door": {
      "lines": [
        "（木门上缠着粗重的锁链。你碰了碰锁头，指腹沾上一层锈粉，锁扣却纹丝不动。）",
        "锁得真紧。",
        "（门缝里透着风，隐约能看见门后还有石阶，往更深的树影里延伸。）",
        "后头似乎还有路。眼下过不去，只能以后再说了。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n33",
      "requires": [],
      "optional": true
    },
    "wood_door_again": {
      "lines": [
        "锁还在，打不开。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ],
      "map_id": "base.map.wumingjiuci",
      "point_id": "base.map.wumingjiuci.point.n33",
      "requires": [
        "wood_door"
      ],
      "optional": true,
      "repeat": true,
      "manual": true
    },
    "stone_door": {
      "lines": [
        "（石门几乎与两侧墙壁连在一起，门上的纹饰一直延到中央的圆形刻痕。门缝很窄，看不见里面。）",
        "这么厚的石门，里面原先放的是什么？",
        "（你试着推了推，门扉没有动。沿边摸了一圈，也没找到门闩或把手。）",
        "打不开。先别在这里耽搁了。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
