  "scenes": {
    "ambush": {
      "label": "翻车商道",
      "lines": [
        "（商道旁翻着一辆马车，车板撞裂了，货箱和包袱散了一地。空车辕上垂着断开的挽带，拉车的马已经不见了。）",
        "（钱掌柜躲在岩石后，一头赤鬃獠猪正用獠牙顶着车架。）",
        "别从车边过！它还在那儿！",
        "钱掌柜，您躲稳了！",
        "它一下就撞过来了，马受了惊，挣断挽带就跑了……你也留神！"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun"
      ],
      "illustration": {
        "image": "res://assets/map-event-z2-1.webp"
      }
    },
    "rescued": {
      "label": "先顾人",
      "lines": [
        "（扶着石头走下来，脚步还有些发虚。）",
        "腿还在抖……方才它撞过来，我连往哪儿跑都忘了。",
        "伤着没有？",
        "没伤着要紧地方，就是吓得不轻。你怎么到这儿来了？",
        "叶伯说您准备从这条路运货回来。我刚在河湾救过人，放心不下，就来看看。",
        "你还特地跑一趟……这份情我记着。",
        "（回头看向货车，伸手想捡近处的包袱，腿一软，又扶住了石头。）",
        "轻的带上就行，车留在这儿。先回镇。",
        "对，货丢了还能再挣，不能把命也搭进去。",
        "能走吗？",
        "能走，就是腿还有点软。你慢些，我跟着你。",
        "（替他捡起脚边的小包，确认他能站稳，才一同往镇子的方向走。）"
      ],
      "line_speakers": [
        "base.npc.qianwanshun",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu"
      ],
      "illustration": {
        "image": "res://assets/map-event-z2-2.webp"
      }
    },
    "town_arrival": {
      "label": "返镇叙话",
      "lines": [
        "来时走的大路，绕是绕了些，好歹平安。回程偏想省这点脚程……",
        "往后接货，多找几个人一道走吧。",
        "是得找个伴。宁肯多等几天，也不能只图省这点工夫。"
      ],
      "line_speakers": [
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun"
      ]
    },
    "shop_return": {
      "label": "护送归铺",
      "lines": [
        "（扶着柜台坐下，缓了缓气，才从钱袋里取出谢礼。）",
        "对了，还没问过，你叫什么名字？",
        "我叫{player.full_name}，在叶伯的药铺帮工。",
        "原来是叶掌柜铺里的。好，我记住了。",
        "这点谢礼你收下。若不是你来，我怕是回不了这铺子了。",
        "您能平安回来就好。",
        "是啊，能回来就好。你也歇歇，今天多亏了你。"
      ],
      "line_speakers": [
        "base.npc.qianwanshun",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun",
        "base.npc.qianwanshun",
        "base.map_player.chen_yu",
        "base.npc.qianwanshun"
      ],
      "illustration": {
        "image": "res://assets/map-event-z2-3.webp"
      }
    }
  },
