  "scenes": {
    "wake": {
      "lines": [
        "（晨光照在窗边，外面已有开门和行人经过的声音。你起身看了看窗外。）",
        "这会儿，叶伯该开铺了。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ],
      "illustration": {
        "image": "res://assets/map-event-1-1.webp"
      }
    },
    "morning": {
      "lines": [
        "（正从药柜里取药，将碎叶拢进柜台上的纸包。听见你进门，抬头看了一眼。）",
        "叶伯，我来了。今天有什么要我帮忙的？",
        "来得正好。铺里的苦艾叶快用完了，替我去山脚采三株回来。",
        "好的，叶伯。还是去瀑布旁边那片吧？前些日子看着长得挺好。",
        "嗯，再去溪边采三株溪露苔。两样分开放，别让湿苔沾着叶子。",
        "好的，我记着了。我带了块干净的布，会分开包好的。",
        "溪边石头滑，够不着的就别采，不差那几株。",
        "好的，叶伯，我知道了。我就在岸边找，不往水里去，您放心。",
        "行，去吧。",
        "（将干净的包药布放进药篓，背好后出了门。）"
      ],
      "line_speakers": [
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu"
      ],
      "illustration": {
        "image": "res://assets/map-event-1-2.webp"
      }
    },
    "returning": {
      "lines": [
        "（将药篓放到柜台旁，掀开包药的布。）",
        "（放下手里的活，过来翻看采回的草药。）",
        "叶伯，药采回来了。溪露苔只取了岸边的，您看看够不够。",
        "够了。这些挑得不错，没混进枯叶。",
        "按您叮嘱的，两样都分开包好了，苦艾叶没沾水。",
        "那就好。先放着，坐下歇会儿。",
        "谢谢叶伯。我先把苦艾叶摊开，免得一直闷在篓里。",
        "旁边那只竹筛空着，用那个吧。",
        "（将苦艾叶摊进竹筛，再把包好的溪露苔放到一旁。）",
        "这是这趟采药的工钱，收着吧。",
        "好的，谢谢叶伯。我先把药篓放回去。",
        "嗯。对了，清禾先前来取药时还问起你，说有点事找你。她在医馆，得空过去一趟吧。",
        "好，叶伯。我把这边收拾妥当就去。",
        "（将空篓放回门边，把用过的包药布叠好。）"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.npc.yesongnian",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ]
    },
    "slope": {
      "lines": [
        "（溪水从石间流过，坡上的草叶长得正好。你沿熟悉的小径往前找去。）"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "see_kuaiye": {
      "lines": [
        "就在这儿。这几株长得不错。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "kuaiye_only": {
      "lines": [
        "苦艾叶够了，再去溪边看看。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "see_xilutai": {
      "lines": [
        "果然还有。采岸边这些就够了，不用往里走。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "xilutai_only": {
      "lines": [
        "收好了，再去坡上找些苦艾叶。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "both": {
      "lines": [
        "都齐了，回铺里吧。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu"
      ]
    },
    "waterfall": {
      "lines": [
        "（水雾遮着岩壁，走近才看清旁边藏着一处幽暗洞口，里面看不见尽头。）",
        "水雾后面……好像有个洞口。",
        "黑漆漆的，也不知道通到哪儿。",
        "叶伯还等着药呢，改日得空再来看看。"
      ],
      "line_speakers": [
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu",
        "base.map_player.chen_yu"
      ]
    }
  }
